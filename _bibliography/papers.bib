  note               = {Preprint.},
  arxiv              = {2407.09104},
  tldr               = {We synthesise user-specific wrist motion data with generative deep learning, reducing the real data needed to enrol users into behavioural authentication systems.},
  abstract           = {Behavioural biometric authentication systems entail an enrolment period that is burdensome for the user. In this work, we explore generating synthetic gestures from a few real user gestures with generative deep learning, with the application of training a simple (i.e. non-deep-learned) authentication model. Specifically, we show that utilising synthetic data alongside real data can reduce the number of real datapoints a user must provide to enrol into a biometric system. To validate our methods, we use the publicly available dataset of WatchAuth, a system proposed in 2022 for authenticating smartwatch payments using the physical gesture of reaching towards a payment terminal. We develop a regularised autoencoder model for generating synthetic user-specific wrist motion data representing these physical gestures, and demonstrate the diversity and fidelity of our synthetic gestures. We show that using synthetic gestures in training can improve classification ability for a real-world system. Through this technique we can reduce the number of gestures required to enrol a user into a WatchAuth-like system by more than 40% without negatively impacting its error rates.},
  selected           = {false},
}

@mastersthesis{webber2023smartwatch_security,
  author             = {G. Webber},
  title              = {Improving the Security of Smartwatch Payment with Deep Learning},
  school             = {University of Oxford},
  year               = {2023},
  month              = jul,
  abbr               = {Thesis / Preprint},
  publication_type   = {workshop},
  first_author       = {true},
  selected           = {false},
  arxiv              = {2307.05437},
  code               = {https://github.com/GeorgeWebber/WatchAuth-DL},
  note               = {Master's dissertation. This broader dissertation preceded the UserBoost preprint.},
  tldr               = {We investigate deep-learned authentication and synthetic wrist gestures to reduce enrolment requirements for secure smartwatch payments.},
  abstract           = {Making contactless payments using a smartwatch is increasingly popular, but this payment medium lacks traditional biometric security measures such as facial or fingerprint recognition. In 2022, Sturgess et al. proposed WatchAuth, a system for authenticating smartwatch payments using the physical gesture of reaching towards a payment terminal. While effective, the system requires the user to undergo a burdensome enrolment period to achieve acceptable error levels. In this dissertation, we explore whether applications of deep learning can reduce the number of gestures a user must provide to enrol into an authentication system for smartwatch payment. We firstly construct a deep-learned authentication system that outperforms the current state-of-the-art, including in a scenario where the target user has provided a limited number of gestures. We then develop a regularised autoencoder model for generating synthetic user-specific gestures. We show that using these gestures in training improves classification ability for an authentication system. Through this technique we can reduce the number of gestures required to enrol a user into a WatchAuth-like system without negatively impacting its error rates.},
}


@inproceedings{webber2026flow_pet,
  author             = {G. Webber and A. Hammers and A. P. King and A. J. Reader},
  title              = {Flow Models for PET Image Reconstruction},
  booktitle          = {IEEE NSS/MIC 2026},
  year               = {2026},
  month              = {nov},
  address            = {Granada, Spain},
  abbr               = {Conference Abstract},
  publication_type   = {abstract},
  venue_display      = {IEEE NSS/MIC},
  tldr               = {We adapt model predictive control guidance of pretrained flow models to PET reconstruction using a Poisson likelihood and explicit intensity scaling.},
  abstract           = {Flow-based generative models can be used as pre-trained priors for inverse problems; however, their use in PET image reconstruction remains largely unexplored. We present a proof-of-principle study using flow priors for 2D PET reconstruction. A U-Net was trained by flow matching on simple brain phantoms and used as an unconditional image prior. We used the MPC-Flow (Model Predictive Control) framework to condition the pre-trained flow via direct control of the generative dynamics, and adapted it to the PET setting by incorporating a Poisson likelihood and an explicit intensity scaling to address the dynamic range mismatch between the generative model and PET data. This method was used to reconstruct images from simulated low-count PET sinogram data. On held-out phantoms, MPC-Flow achieved lower error than diffusion-based reconstruction and conventional iterative baselines, likely due to the explicit control objective, which balances likelihood maximization with a penalty on deviations from the learned flow trajectory. These results demonstrate that flow priors can be coupled with PET likelihoods in a principled framework. Evaluation on more realistic anatomical phantoms and clinical data, where the learned manifold may be less accurate, will be a necessary next step.},
  first_author       = {true},
  note               = {Oral presentation},
  selected           = {false},
}


@inproceedings{chandrasekaran2026plug_and_play,
  author             = {K. Chandrasekaran and G. Webber and A. Denker and M. J. Ehrhardt},
  title              = {Plug-and-Play Learned Regularization in PET Reconstruction: Integration of DeepInverse and STIR through SIRF},
  booktitle          = {IEEE NSS/MIC 2026},
  year               = {2026},
  month              = {nov},
  address            = {Granada, Spain},
  abbr               = {Conference Abstract},
  publication_type   = {abstract},
  venue_display      = {IEEE NSS/MIC},
  tldr               = {We integrate DeepInverse with SIRF and STIR to enable plug-and-play learned regularisation within physics-based PET reconstruction.},
  abstract           = {This work presents a modular software integration framework that bridges physics-based PET reconstruction with modern deep learning regularization. While deep learning has shown significant promise in medical imaging, integrating learned priors into established reconstruction pipelines remains a challenge. We address this by developing a direct interface between the DeepInverse library and the Synergistic Image Reconstruction Framework (SIRF), which wraps the Software for Tomographic Image Reconstruction (STIR) engine. This integration enables the direct deployment of learned priors, such as the Deep Residual UNet (DRUNet) and Weakly Convex Ridge Regularizers (WCRR), within accurate physics-based forward models. To demonstrate the framework's flexibility, we integrate and evaluate three reconstruction strategies using learned regularization: PnP-PD3O (WCRR), PnP-SVRG (DRUNet), and PnP-HQS (DRUNet). Performance is validated using a simulated 2D thorax phantom, comparing the proposed framework against Ordered Subsets Maximum A Posteriori One Step Late (OSMAPOSL), corresponding to standard Ordered Subsets Expectation Maximization (OSEM) reconstruction when no prior is applied, and OSMAPOSL with Relative Difference Prior (RDP) baselines. Quantitative results demonstrate improved image fidelity using learned regularization. As a representative example, the PnP-SVRG approach achieved a Peak Signal-to-Noise Ratio (PSNR) of 45.90 dB, compared to 39.52 dB for baseline OSEM, showing improved reconstruction quality using this unified interface. The framework suppresses noise while preserving structural details. By providing an open-source Python-based bridge, this work lowers the barrier for evaluating state-of-the-art inverse-problem techniques in realistic clinical PET imaging scenarios.},
  code               = {https://github.com/GeorgeWebber/SIRF-Contribs-PnP-DI},
  first_author       = {false},
  selected           = {false},
}


@inproceedings{wei2026spect_diffusion,
  author             = {H. Wei and L. Livieratos and G. Webber and A. J. Reader},
  title              = {SPECT Reconstruction via Diffusion Sampling from a PET Image Manifold for Theranostics},
  booktitle          = {IEEE NSS/MIC 2026},
  year               = {2026},
  month              = {nov},
  address            = {Granada, Spain},
  abbr               = {Conference Abstract},
  publication_type   = {abstract},
  venue_display      = {IEEE NSS/MIC},
  tldr               = {We investigate generative priors learned from PET images to guide SPECT reconstruction for theranostic applications.},
  abstract           = {Single photon emission computed tomography (SPECT) remains the standard modality for uptake verification and patient-specific dosimetry in molecular radiotherapy (MRT), however it has limited spatial resolution and noise characteristics compared to pre-therapy positron emission tomography (PET). Existing approaches that incorporate PET priors into SPECT reconstruction are often constrained by hand-crafted feature representations and suffer from inter-modality mismatch and registration-induced artifacts. In this work, we employ a conditional generative framework to enhance SPECT reconstruction toward PET-level image quality. A denoising diffusion probabilistic model (DDPM) is trained to learn the distribution of high-quality PET images. During inference, the reverse diffusion process is conditioned on measured SPECT data and CT images, enabling anatomically consistent, high-fidelity image synthesis. The method is initially assessed using 2D Zubal phantom simulations. Performance is compared with conventional maximum likelihood expectation maximization (MLEM) and kernel based methods. Both quantitative metrics and qualitative analysis demonstrate that the diffusion-based approach achieves enhanced edge preservation and superior noise suppression. The reconstructed images show closer agreement with reference data compared to MLEM and kernel based reconstructions. By avoiding explicit PET–SPECT registration, the framework mitigates spatial misalignment and associated artifacts. These results indicate that conditional diffusion sampling provides a principled and flexible approach to improve resolution and noise limitations in SPECT, with potential to improve quantitative accuracy in MRT applications.},
  first_author       = {false},
  selected           = {false},
}


@inproceedings{poveda2026domain_randomization,
  author             = {J. Poveda-Martínez and J. P. Gómez-González and F. J. López-González and C. Dominguez-Borrero and M. A. Belzunce and G. Webber and A. J. Reader and P. Aguiar and J. Silva-Rodríguez},
  title              = {Improving Generalization of PET Image-Enhancing Deep Learned Models Through Domain Randomization},
  booktitle          = {IEEE NSS/MIC 2026},
  year               = {2026},
  month              = {nov},
  address            = {Granada, Spain},
  abbr               = {Conference Abstract},
  publication_type   = {abstract},
  venue_display      = {IEEE NSS/MIC},
  tldr               = {We investigate domain randomisation to improve the generalisation of learned PET image enhancement across scanner configurations.},
  abstract           = {Deep learning models for PET image enhancement often struggle to generalize across unseen scanner configurations due to limited training data diversity. We introduce a Domain Randomization (DR) framework that utilizes Monte Carlo simulations via the SimPET platform to randomize scanner geometries and reconstruction protocols within clinically operational ranges. To mimic biological variability, this approach is supplemented by a tailored activity augmentation pipeline, resulting in a training dataset of 232 activity maps. To validate this methodology, we trained a 2.5D Attention U-Net to map simulations to high-quality activity maps. Performance was assessed across incremental data regimes ranging from 20 to 236 training instances. On unseen scanner domains, the DR strategy consistently outperformed the no-DR baseline in SSIM and relative contrast. Conversely, on the in-distribution source domain, the DR model achieved perceptual equivalence to the baseline, despite a minor trade-off in absolute pixel precision. Real-world validation with a Hoffman Phantom acquisition on a Philips Vereos scanner suggested a remaining sim-to-real gap on real data distributions. By demonstrating improved generalization without compromising structural fidelity on synthetic domains, this work presents a promising pathway for future research and democratizes access to high-quality, annotated training data through scalable and cost-effective deep learning tools.},
  first_author       = {false},
  selected           = {false},
}
