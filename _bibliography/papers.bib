  author             = {G. Webber and J. Sturgess and I. Martinovic},
  title              = {UserBoost: Generating User-specific Synthetic Data for Faster Enrolment into Behavioural Biometric Systems},
  year               = {2024},
  month              = {jul},
  abbr               = {Preprint},
